{
  "schema_version": 1,
  "scope": "Named assertions and effects, not a security percentage",
  "controls": [
    {"control_id": "authentication", "requirement": "Verified issuer, audience, role and workload root", "positive": ["test_authentication_rejects_missing_signature_wrong_issuer_audience_expiry_and_role_spoof"], "negative": ["test_workload_token_cannot_change_root_or_use_operator_endpoints"]},
    {"control_id": "tenant_isolation", "requirement": "Cross-tenant access never reaches the resource", "positive": ["test_legal_read_memory_and_report"], "negative": ["test_cross_tenant_does_not_reach_connector_or_guard"]},
    {"control_id": "secrets", "requirement": "No secret in persisted input or released output", "positive": ["test_legal_text_is_allowed"], "negative": ["test_secret_rejection_never_persists_plaintext", "test_last_output_secret_is_never_returned"]},
    {"control_id": "pii", "requirement": "Actual stored redaction and strict denial", "positive": ["test_checksums_prevent_invalid_identifier_false_positive"], "negative": ["test_pii_redacts_actual_stored_report", "test_pii_redaction_and_strict_pair"]},
    {"control_id": "semantic", "requirement": "Real AI influences decisions across full inputs; unknown fails closed", "positive": ["test_real_legal_workflow_and_memory"], "negative": ["test_real_semantic_holdout", "test_real_hidden_goal_drift_in_middle_of_64kib_never_reaches_sink", "test_unknown_guard_fails_closed"], "requires_real_model": true},
    {"control_id": "historical_attacks", "requirement": "No unsafe loader, template or code execution", "positive": ["test_historical_json_pair_never_calls_loader", "test_artifact_digest_source_format_and_runtime_pairs"], "negative": ["test_gguf_template_must_be_exactly_approved", "test_calculator_rejects_code_and_resource_abuse"]},
    {"control_id": "flow", "requirement": "Monotonic labels, public projection and owner fencing", "positive": ["test_public_projection_finishes_before_confidential_read"], "negative": ["test_encoded_memory_delegation_cannot_export_with_false_benign", "test_previous_owner_cannot_release_after_root_fence_changes"]},
    {"control_id": "approval", "requirement": "Exact approved effect occurs once", "positive": ["test_exact_approval_one_effect_and_replay_conflict"], "negative": ["test_exact_approval_rejects_wrong_hash_role_tenant_and_replay_then_records_one_effect"]},
    {"control_id": "budget", "requirement": "Atomic admission, exact limits and preserved unknown obligations", "positive": ["test_exact_boundary_and_unknown_are_not_free"], "negative": ["test_fifty_parallel_reservations_do_not_overspend", "test_actual_usage_overrun_is_preserved_and_kills_new_work"]},
    {"control_id": "publication", "requirement": "No stale generation or uninspected stream prefix", "positive": ["test_buffered_stream_releases_only_inspected_complete_content"], "negative": ["test_unsafe_complete_model_result_emits_no_stream_prefix", "test_generation_change_after_execution_quarantines_result"]},
    {"control_id": "policy_feed", "requirement": "Signed complete configuration and approved feed change decisions", "positive": ["test_signed_feed_add_remove_changes_decision"], "negative": ["test_signature_tamper_unknown_key_and_rollback", "test_feed_required_and_expired_fail_closed"]},
    {"control_id": "mcp", "requirement": "Official protocols without expanded authority", "positive": ["test_official_client_routes_tools_resources_and_prompt_through_authenticated_context", "test_pinned_stdio_process_forwards_authorized_tools_resources_and_denies_protocol_expansion"], "negative": ["test_mcp_transport_rejects_missing_identity_cross_root_origin_and_unapproved_method", "test_registered_upstream_descriptor_rejects_changed_description_and_schema"]},
    {"control_id": "recovery", "requirement": "Durable uncertain outcome, bounded encrypted spool", "positive": ["test_journal_encrypts_only_metadata_and_respects_capacity"], "negative": ["test_database_loss_after_dispatch_uses_bounded_metadata_journal_and_never_releases_result", "test_lost_upstream_outcome_retains_uncertain_reservation"]},
    {"control_id": "audit_replay", "requirement": "Append-only signed audit, isolated replay without repeated effects", "positive": ["test_live_checkpoint_signed_and_persisted_outside_database", "test_synthetic_comparison_has_separate_budget_and_zero_business_effects"], "negative": ["test_runtime_database_identity_cannot_edit_audit", "test_audit_detects_changed_removed_and_reordered_metadata"]},
    {"control_id": "runtime", "requirement": "Verified workers, full context, stop and isolation", "positive": ["test_actual_runtime_and_network_evidence", "test_both_real_gateway_replicas_adopt_same_snapshot"], "negative": ["test_generation_response_mismatch_preserves_real_usage", "test_transport_failure_never_claims_confirmed_stop"]},
    {"control_id": "bounded_input_fuzz", "requirement": "Generated parser, Unicode, typed payload, feed and path boundaries preserve explicit invariants", "positive": ["test_fuzz_json_round_trip_preserves_exact_data_and_canonical_bytes", "test_fuzz_calculator_has_arithmetic_semantics_and_no_code_suffix", "test_fuzz_signed_feed_is_package_scoped_and_signature_revision_bound"], "negative": ["test_fuzz_duplicate_json_and_yaml_keys_never_choose_an_authoritative_value", "test_fuzz_unicode_secret_never_returns_a_copy_in_result_or_audit_metadata", "test_fuzz_typed_payload_rejects_extra_authority_fields_without_mutating_data", "test_fuzz_registry_paths_stay_inside_the_approved_policy_directory"]},
    {"control_id": "stateful_lifecycle", "requirement": "Generated reserve, dispatch, settle, cancel, retry and client restart traces retain obligations and never duplicate a real sink effect", "positive": ["test_stateful_reserve_dispatch_settle_cancel_retry_restart_preserves_money_and_effects"], "negative": ["test_stateful_reserve_dispatch_settle_cancel_retry_restart_preserves_money_and_effects"]}
  ]
}
